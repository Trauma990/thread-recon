{
  "manifest_version": 3,
  "name": "Thread Recon — Facebook OSINT",
  "version": "1.7.0",
  "minimum_chrome_version": "114",
  "description": "Find comments, replies, reactions and mentions across Facebook posts.",
  "permissions": ["scripting", "sidePanel", "storage", "notifications"],
  "host_permissions": ["https://*.facebook.com/*"],
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"},
  "action": {
    "default_title": "Open Thread Recon",
    "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}
  },
  "side_panel": {"default_path": "index.html"},
  "background": {"service_worker": "open.js"}
}
